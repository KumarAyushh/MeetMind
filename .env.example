# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=""

# --- Redis (BullMQ queue) ---
REDIS_URL="

# --- API server ---
NODE_ENV=development               # development | test | production
API_PORT=xxxx
WEB_ORIGIN=""   # Vite dev server; used for CORS + Socket.io

# --- Auth (filled in during the auth phase) ---
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# --- AI provider: Gemini (filled in during the AI phase) ---
GEMINI_API_KEY=""

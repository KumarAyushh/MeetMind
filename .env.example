# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (read by docker-compose.yml on the FIRST start of an empty volume) ---
# Changing these later needs a fresh volume: docker compose down -v && pnpm db:up
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meetmind
# Must use the same user/password/db as above.
DATABASE_URL="postgresql://meetmind:change-me@localhost:5432/meetmind"

# --- Redis (BullMQ queue) ---
REDIS_PASSWORD=change-me
# Password goes after the ":" (empty username = Redis "default" user).
# In production use the managed provider's URL, e.g. rediss://default:<pw>@host:6379
# ("rediss" with two s = TLS).
REDIS_URL="redis://:change-me@localhost:6379"

# --- API server ---
NODE_ENV=development               # development | test | production
API_PORT=xxxx
WEB_ORIGIN=""   # Vite dev server; used for CORS + Socket.io

# --- Auth (filled in during the auth phase) ---
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# --- AI provider: Gemini (filled in during the AI phase) ---
GEMINI_API_KEY=""

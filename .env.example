# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://meetingmind:meetingmind@localhost:5432/meetingmind"

# --- Redis (BullMQ queue) ---
REDIS_URL="redis://localhost:6379"

# --- API server ---
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"   # Vite dev server; used for CORS + Socket.io

# --- Auth (filled in during the auth phase) ---
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# --- AI providers (filled in during the AI phase) ---
ANTHROPIC_API_KEY=""
EMBEDDINGS_API_KEY=""
